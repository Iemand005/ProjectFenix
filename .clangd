CompileFlags:
  Compiler: clang++
  Add:
    - "-std=c++17"
    - "-D__EMSCRIPTEN__"
    - "-DFE_EXCLUDE_GLFW"
    - "-DFE_EXCLUDE_VULKAN"
    - "-DFE_EXCLUDE_JOLT"
    - "-DFE_EXCLUDE_OPENXR"
    - "-DFE_EXCLUDE_SDL"
    - "-D_ENABLE_EXTENDED_ALIGNED_STORAGE"
    - "-DEXCLUDE_JOLT"
    - "-isystem"
    - "J:/emsdk/upstream/emscripten/cache/sysroot/include"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/include"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/external"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/external/glm"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/external/imgui"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/external/cgltf"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/external/SDL/include"
    - "-I"
    - "J:/ProjectFenix/FenixEngine/src/Engine"
    - "-I"
    - "J:/ProjectFenix/FenixWeb"
