# Native Windows / MSVC projects: use the clang-cl driver so the MSVC-style flags in
# compile_commands.json (e.g. /std:c++17, /EHsc, /external:I) are honored instead of
# being dropped as "unknown arguments". clang-cl also picks up the real C++17 mode.
# All include paths come from the per-platform compile_commands.json generated by CMake
# (see .vscode/settings.json -> clangd.arguments -> --compile-commands-dir),
# so no project paths are hardcoded here.
CompileFlags:
  Compiler: clang-cl
  Add:
    - "-std:c++17"
    # Dead-code diagnostics MSVC lacks. Note: these only fire for private fields of
    # trivial/copyable types never read (non-trivial members like std::vector are
    # exempt, and a ctor-body write counts as a use) and for members/functions of
    # local/anonymous types. External-linkage header classes are exempt by design,
    # so no false positives there.
    - "-Wunused-private-field"
    - "-Wunused-member-function"
    - "-Wunused-function"
If:
  PathMatch: [".*Foxcraft.*", ".*FenixEngine.*", ".*FenixEditor.*", ".*Tunnel.*", ".*ShaderSavers.*", ".*Labyrinth.*", ".*FoxRacing.*", ".*Atmosphere.*", ".*Cake.*"]

---
# Emscripten web build (FenixWeb): has no MSVC compile_commands.json entry, so provide the
# emscripten includes/defines manually. The engine paths are relative to the FenixWeb
# directory. Must stay scoped away from native code, otherwise it poisons the MSVC STL.
# The emscripten sysroot lives in the (machine-local) Emscripten SDK install, not the repo.
CompileFlags:
  Add:
    - "-std=c++17"
    - "-Wunused-variable"
    - "-D__EMSCRIPTEN__"
    - "-DFE_EXCLUDE_GLFW"
    - "-DFE_EXCLUDE_VULKAN"
    - "-DFE_EXCLUDE_JOLT"
    - "-DFE_EXCLUDE_OPENXR"
    - "-DFE_EXCLUDE_SDL"
    - "-D_ENABLE_EXTENDED_ALIGNED_STORAGE"
    - "-DEXCLUDE_JOLT"
    - "-isystem"
    - "J:/emsdk/upstream/emscripten/cache/sysroot/include"
    - "-I"
    - "../FenixEngine/include"
    - "-I"
    - "../FenixEngine/external"
    - "-I"
    - "../FenixEngine/external/glm"
    - "-I"
    - "../FenixEngine/external/imgui"
    - "-I"
    - "../FenixEngine/external/cgltf"
    - "-I"
    - "../FenixEngine/external/SDL/include"
    - "-I"
    - "../FenixEngine/src/Engine"
    - "-I"
    - "."
If:
  PathMatch: [".*FenixWeb.*"]