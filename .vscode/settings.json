{
	"editor.indentSize": "tabSize",
	"editor.insertSpaces": false,
	"C_Cpp.files.exclude": {
		// "**/external/**": true,
		"**/include/**": true,
		"**/build/**": true,
	},
	"files.watcherExclude": {
		"**/external/**": true,
		"**/include/**": true,
		"**/build/**": true,
	},
	"search.exclude": {
		"**/external/**": true,
		"**/include/**": true,
		// "**/build/**": true,
	},
	"files.exclude": {
		// "**/external/**": true,
		"**/include/**": true,
		// "**/build/**": true,
	},
	"C_Cpp.intelliSenseCacheSize": 512,
	"C_Cpp.maxConcurrentThreads": 4,
	"C_Cpp.errorLimit": 100,
	"output.smartScroll.enabled": false,
	// "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
	// "cmake.generator": "Ninja",
	"cmake.configureArgs": [
		"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
	],
	"clangd.arguments": [
		"--compile-commands-dir=build"
	],
	"git.ignoredRepositories": [
		"FenixEngine/external/**",
		"FenixEngine/external"
	],
	"git.autoRepositoryDetection": "openEditors",
	"workbench.colorCustomizations": {
		"activityBar.background": "#3E253D",
		"titleBar.activeBackground": "#573356",
		"titleBar.activeForeground": "#FCF9FC",
		"titleBar.inactiveBackground": "#3E253D",
		"titleBar.inactiveForeground": "#FCF9FC",
		"statusBar.background": "#3E253D",
		"statusBar.foreground": "#FCF9FC",
		"statusBar.debuggingBackground": "#3E253D",
		"statusBar.debuggingForeground": "#FCF9FC",
		"statusBar.noFolderBackground": "#3E253D",
		"statusBar.noFolderForeground": "#FCF9FC"
	},

	// "cmake.generator": "Visual Studio 18 2026",
	// "cmake.configureSettings": {
	// 	// "CMAKE_GENERATOR_TOOLSET": "v141"
	// 	"CMAKE_GENERATOR_TOOLSET": "v141,version=14.16.27023"
	// }

	"git.detectSubmodulesLimit": 30,
	"liveServer.settings.port": 5502
}