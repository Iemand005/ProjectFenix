{
	"editor.indentSize": "tabSize",
	"editor.insertSpaces": false,
	"C_Cpp.files.exclude": {
		// "**/external/**": true,
		// "**/include/**": true,
		"**/build/**": true,
	},
	"files.watcherExclude": {
		"**/external/**": true,
		// "**/include/**": true,
		"**/build/**": true,
	},
	"search.exclude": {
		"**/external/**": true,
		// "**/include/**": true,
		// "**/build/**": true,
	},
	"files.exclude": {
		// "**/external/**": true,
		// "**/include/**": true,
		// "**/build/**": true,
	},
	"C_Cpp.intelliSenseCacheSize": 512,
	"C_Cpp.maxConcurrentThreads": 4,
	"C_Cpp.errorLimit": 100,
	"output.smartScroll.enabled": false,
	"cmake.configurePreset": "windows-msvc-2026",
	"cmake.buildPreset": "SuperFlight-debug",
	"cmake.configureArgs": [
		"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
	],
	"clangd.arguments": [
		"--compile-commands-dir=${workspaceFolder}/build/desktop-meta"
	],
	"git.ignoredRepositories": [
		"FenixEngine/external/**",
		"FenixEngine/external"
	],
	"git.autoRepositoryDetection": "openEditors",
	"workbench.colorCustomizations": {
		"activityBar.background": "#1d1d1d",
		"activityBar.foreground": "#f7f6f6",
		"activityBar.activeBackground": "#ff00a6",
		"activityBar.inactiveForeground": "#bfbfbf",
		"titleBar.activeBackground": "#1d1d1d",
		"titleBar.activeForeground": "#FFF8F4",
		"statusBar.background": "#71014a",
		"statusBar.foreground": "#FFF8F4",
		"statusBar.debuggingBackground": "#c2bf03",
		"statusBar.debuggingForeground": "#FFF8F4",
		"statusBar.noFolderBackground": "#ff00a6",
		"statusBar.noFolderForeground": "#FFF8F4",
		"button.background": "#ff00a6",
		"button.foreground": "#ffffff",
		"button.border": "#ff00a6",
		"button.hoverBackground": "#ff00a6",
		"button.secondaryBackground": "#333333",
		"button.secondaryForeground": "#ffffff"
	}
}